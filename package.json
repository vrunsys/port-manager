{
  "name": "port-manager",
  "displayName": "Port Manager",
  "description": "See which processes are listening on local ports.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Port Manager lists and stops processes on the machine it runs on, which a virtual workspace does not have."
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "port-manager",
          "title": "Port Manager",
          "icon": "$(stop-circle)"
        }
      ]
    },
    "views": {
      "port-manager": [
        {
          "id": "port-manager.ports",
          "name": "Listening Ports"
        }
      ]
    },
    "configuration": {
      "title": "Port Manager",
      "properties": {
        "portManager.refreshInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 600,
          "description": "Seconds between port scans while the Port Manager view or status bar item is on screen. Minimum 1."
        },
        "portManager.confirmBeforeKill": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before stopping a process.",
          "scope": "machine-overridable"
        },
        "portManager.protectedPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "Ports whose processes Port Manager will never stop, e.g. `[22, 5432]`.",
          "scope": "machine-overridable"
        },
        "portManager.protectedProcesses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "Process names Port Manager will never stop, e.g. `[\"sshd\", \"postgres\"]`. Case and `.exe` do not matter; the executable name from the command line is matched too (useful for `node`).",
          "scope": "machine-overridable"
        },
        "portManager.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the number of listening ports in the status bar. Click it to open the Port Manager view."
        }
      }
    },
    "commands": [
      {
        "command": "port-manager.refresh",
        "title": "Refresh",
        "category": "Port Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "port-manager.filter",
        "title": "Filter Ports…",
        "category": "Port Manager",
        "icon": "$(search)"
      },
      {
        "command": "port-manager.clearFilter",
        "title": "Clear Filter",
        "category": "Port Manager",
        "icon": "$(clear-all)"
      },
      {
        "command": "port-manager.showRunningOnly",
        "title": "Show Running Only",
        "category": "Port Manager",
        "icon": "$(filter)"
      },
      {
        "command": "port-manager.showAllPorts",
        "title": "Show All Ports",
        "category": "Port Manager",
        "icon": "$(filter-filled)"
      },
      {
        "command": "port-manager.sort",
        "title": "Sort Ports…",
        "category": "Port Manager",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "port-manager.kill",
        "title": "Kill Process",
        "category": "Port Manager",
        "icon": "$(debug-stop)"
      },
      {
        "command": "port-manager.rename",
        "title": "Rename…",
        "category": "Port Manager",
        "icon": "$(edit)"
      },
      {
        "command": "port-manager.killByPort",
        "title": "Kill Process on Port…",
        "category": "Port Manager"
      },
      {
        "command": "port-manager.copyPort",
        "title": "Copy Port",
        "category": "Port Manager",
        "icon": "$(copy)"
      },
      {
        "command": "port-manager.copyPid",
        "title": "Copy PID",
        "category": "Port Manager"
      },
      {
        "command": "port-manager.openInBrowser",
        "title": "Open in Browser",
        "category": "Port Manager",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "port-manager.filter",
          "when": "view == port-manager.ports",
          "group": "navigation@1"
        },
        {
          "command": "port-manager.showRunningOnly",
          "when": "view == port-manager.ports && !portManager.runningOnly",
          "group": "navigation@2"
        },
        {
          "command": "port-manager.showAllPorts",
          "when": "view == port-manager.ports && portManager.runningOnly",
          "group": "navigation@2"
        },
        {
          "command": "port-manager.sort",
          "when": "view == port-manager.ports",
          "group": "navigation@3"
        },
        {
          "command": "port-manager.clearFilter",
          "when": "view == port-manager.ports && portManager.filterActive",
          "group": "navigation@4"
        },
        {
          "command": "port-manager.refresh",
          "when": "view == port-manager.ports",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "port-manager.rename",
          "when": "view == port-manager.ports",
          "group": "inline@1"
        },
        {
          "command": "port-manager.openInBrowser",
          "when": "view == port-manager.ports",
          "group": "inline@2"
        },
        {
          "command": "port-manager.kill",
          "when": "view == port-manager.ports && viewItem == port",
          "group": "inline@3"
        },
        {
          "command": "port-manager.openInBrowser",
          "when": "view == port-manager.ports",
          "group": "1_open@1"
        },
        {
          "command": "port-manager.copyPort",
          "when": "view == port-manager.ports",
          "group": "2_copy@1"
        },
        {
          "command": "port-manager.copyPid",
          "when": "view == port-manager.ports && viewItem != port-hidden",
          "group": "2_copy@2"
        },
        {
          "command": "port-manager.kill",
          "when": "view == port-manager.ports && viewItem == port",
          "group": "3_kill@1"
        },
        {
          "command": "port-manager.rename",
          "when": "view == port-manager.ports",
          "group": "2_edit@1"
        }
      ],
      "commandPalette": [
        {
          "command": "port-manager.kill",
          "when": "false"
        },
        {
          "command": "port-manager.copyPort",
          "when": "false"
        },
        {
          "command": "port-manager.copyPid",
          "when": "false"
        },
        {
          "command": "port-manager.openInBrowser",
          "when": "false"
        },
        {
          "command": "port-manager.rename",
          "when": "false"
        },
        {
          "command": "port-manager.clearFilter",
          "when": "portManager.filterActive"
        },
        {
          "command": "port-manager.showRunningOnly",
          "when": "!portManager.runningOnly"
        },
        {
          "command": "port-manager.showAllPorts",
          "when": "portManager.runningOnly"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.5"
  }
}
