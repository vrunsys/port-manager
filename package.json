{
  "name": "port-manager",
  "displayName": "Port Manager",
  "description": "See which processes are listening on local ports.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "port-manager",
          "title": "Port Manager",
          "icon": "$(stop-circle)"
        }
      ]
    },
    "views": {
      "port-manager": [
        {
          "id": "port-manager.ports",
          "name": "Listening Ports"
        }
      ]
    },
    "configuration": {
      "title": "Port Manager",
      "properties": {
        "port-manager.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the number of listening ports in the status bar. Click it to open the Port Manager view."
        }
      }
    },
    "commands": [
      {
        "command": "port-manager.refresh",
        "title": "Refresh",
        "category": "Port Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "port-manager.kill",
        "title": "Kill Process",
        "category": "Port Manager",
        "icon": "$(close)"
      },
      {
        "command": "port-manager.killByPort",
        "title": "Kill Process on Port…",
        "category": "Port Manager"
      },
      {
        "command": "port-manager.copyPort",
        "title": "Copy Port",
        "category": "Port Manager",
        "icon": "$(copy)"
      },
      {
        "command": "port-manager.copyPid",
        "title": "Copy PID",
        "category": "Port Manager"
      },
      {
        "command": "port-manager.openInBrowser",
        "title": "Open in Browser",
        "category": "Port Manager",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "port-manager.refresh",
          "when": "view == port-manager.ports",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "port-manager.openInBrowser",
          "when": "view == port-manager.ports",
          "group": "inline@1"
        },
        {
          "command": "port-manager.kill",
          "when": "view == port-manager.ports && viewItem == port",
          "group": "inline@2"
        },
        {
          "command": "port-manager.openInBrowser",
          "when": "view == port-manager.ports",
          "group": "1_open@1"
        },
        {
          "command": "port-manager.copyPort",
          "when": "view == port-manager.ports",
          "group": "2_copy@1"
        },
        {
          "command": "port-manager.copyPid",
          "when": "view == port-manager.ports && viewItem == port",
          "group": "2_copy@2"
        },
        {
          "command": "port-manager.kill",
          "when": "view == port-manager.ports && viewItem == port",
          "group": "3_kill@1"
        }
      ],
      "commandPalette": [
        { "command": "port-manager.kill", "when": "false" },
        { "command": "port-manager.copyPort", "when": "false" },
        { "command": "port-manager.copyPid", "when": "false" },
        { "command": "port-manager.openInBrowser", "when": "false" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@vscode/vsce": "^4.1.0"
  }
}
